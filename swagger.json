{
  "openapi": "3.0.3",
  "info": {
    "title": "Backend API",
    "version": "1.0.0",
    "description": "REST API for user registration, authentication, user lookup, role checks, and file uploads. This specification documents the current Express implementation. The API has no /api prefix. Set the server URL to the host and PORT where the service is running. Protected operations accept a JWT in the Authorization header using Bearer <JWT>. The current implementation uses an in-memory user store, returns password fields in user lookup responses, and does not currently verify submitted passwords during login; review the security notes in API.md before using this service in production.",
    "contact": {}
  },
  "servers": [
    {
      "url": "http://localhost:5700",
      "description": "Local development server. Replace the host and port for deployed environments.",
      "variables": {
        "port": {
          "default": "5700",
          "description": "The PORT value configured for the server."
        }
      }
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Service health and static file access."
    },
    {
      "name": "Authentication",
      "description": "User registration and JWT login."
    },
    {
      "name": "Users",
      "description": "Authenticated user search and lookup."
    },
    {
      "name": "Roles",
      "description": "Role-protected example endpoints."
    },
    {
      "name": "Files",
      "description": "Multipart file upload and public file retrieval."
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Check whether the API is running",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "The service is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "success",
                  "message": "Welcome, API is running"
                }
              }
            }
          }
        }
      }
    },
    "/uploads/{filename}": {
      "get": {
        "tags": [
          "Files"
        ],
        "summary": "Download an uploaded file",
        "operationId": "downloadUploadedFile",
        "description": "Files in the uploads directory are served publicly by Express static middleware. The filename is the value returned in the path field of a successful upload response.",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/UploadedFilename"
          }
        ],
        "responses": {
          "200": {
            "description": "The requested file.",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "The file does not exist. The response may be generated by Express rather than the application's JSON error handler."
          }
        }
      }
    },
    "/user/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register a user",
        "operationId": "registerUser",
        "description": "Creates a user in the in-memory store. New users receive the user role. The current implementation returns HTTP 200 for successful registration.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "example": {
                "name": "Avery4",
                "email": "newuser@example.com",
                "phone": "01234567890",
                "password": "ExamplePass1!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User registered successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                },
                "example": {
                  "status": "success",
                  "message": "User registered successfully"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationBadRequest"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/user/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log in and obtain a JWT",
        "operationId": "loginUser",
        "description": "Validates the email and password fields and returns a one-hour JWT for an existing user. The current implementation does not compare the submitted password with the stored password.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "email": "newuser@example.com",
                "password": "ExamplePass1!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "example": {
                  "status": "success",
                  "message": "Login successful",
                  "role": "user",
                  "token": "<JWT>"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/user/": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Search users",
        "operationId": "searchUsers",
        "description": "Returns users whose name or email contains the query value without case sensitivity, or whose phone contains the query value. The endpoint is authenticated but does not restrict access by role or ownership. The current implementation does not validate the query parameter before using it.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/UserQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "Matching users.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserListResponse"
                },
                "example": {
                  "status": "success",
                  "data": [
                    {
                      "id": 9,
                      "name": "Avery4",
                      "email": "newuser@example.com",
                      "phone": "01234567890",
                      "role": "user",
                      "password": "[redacted]"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/user/{id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get a user by ID",
        "operationId": "getUserById",
        "description": "Returns one user by the numeric ID supplied in the URL. The current implementation converts the path value with Number and does not enforce integer-only input.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          }
        ],
        "responses": {
          "200": {
            "description": "User found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                },
                "example": {
                  "status": "success",
                  "data": {
                    "id": 1,
                    "name": "devv",
                    "email": "devv@example.com",
                    "phone": "09047676746",
                    "role": "user",
                    "password": "[redacted]"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/role/admin": {
      "get": {
        "tags": [
          "Roles"
        ],
        "summary": "Access the admin example endpoint",
        "operationId": "getAdminWelcome",
        "description": "Requires a valid JWT whose role claim is admin.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Admin access granted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleWelcomeResponse"
                },
                "example": {
                  "status": "success",
                  "message": "Welcome, Admin"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/role/user": {
      "get": {
        "tags": [
          "Roles"
        ],
        "summary": "Access the authenticated user example endpoint",
        "operationId": "getUserWelcome",
        "description": "Requires a valid JWT. Both user and admin roles are accepted.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated access granted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleWelcomeResponse"
                },
                "example": {
                  "status": "success",
                  "message": "Welcome, User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/file/upload": {
      "post": {
        "tags": [
          "Files"
        ],
        "summary": "Upload a file",
        "operationId": "uploadFile",
        "description": "Accepts one multipart file field named file. The maximum size is 5 MB. Accepted client-declared MIME types are image/jpeg, image/png, image/gif, image/webp, application/pdf, and text/plain. The endpoint is public in the current implementation.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/FileUploadRequest"
              },
              "example": {
                "file": "example.png"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File uploaded successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUploadResponse"
                },
                "example": {
                  "message": "File uploaded successfully",
                  "file": {
                    "originalname": "example.png",
                    "filename": "example-1700000000000-123456789.png",
                    "path": "/uploads/example-1700000000000-123456789.png",
                    "size": 12345,
                    "mimetype": "image/png"
                  }
                }
              }
            }
          },
          "400": {
            "description": "No file was provided, the MIME type is not allowed, the file exceeds 5 MB, or another Multer error occurred.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missingFile": {
                    "summary": "No file",
                    "value": {
                      "message": "No file uploaded"
                    }
                  },
                  "disallowedType": {
                    "summary": "Disallowed MIME type",
                    "value": {
                      "status": "error",
                      "message": "File type not allowed"
                    }
                  },
                  "tooLarge": {
                    "summary": "File too large",
                    "value": {
                      "status": "error",
                      "message": "File too large (max 5MB)"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Use the token returned by POST /user/login as Authorization: Bearer <JWT>. Tokens expire after one hour."
      }
    },
    "parameters": {
      "UserId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "User ID. The controller converts the value to a number; the current implementation does not strictly validate integer syntax.",
        "schema": {
          "type": "string",
          "example": "1"
        }
      },
      "UserQuery": {
        "name": "query",
        "in": "query",
        "required": true,
        "allowEmptyValue": true,
        "description": "Search text used against name, email, and phone. An empty value matches all users in the current implementation.",
        "schema": {
          "type": "string",
          "example": "Avery"
        }
      },
      "UploadedFilename": {
        "name": "filename",
        "in": "path",
        "required": true,
        "description": "Filename returned in the path field of an upload response. URL-encode the filename when constructing the request URL.",
        "schema": {
          "type": "string",
          "example": "example-1700000000000-123456789.png"
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "message": {
            "type": "string",
            "example": "Welcome, API is running"
          }
        },
        "additionalProperties": false
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "name",
          "email",
          "phone",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 4,
            "pattern": ".*[0-9].*",
            "description": "Trimmed name that must contain at least one number."
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Trimmed email address."
          },
          "phone": {
            "type": "string",
            "minLength": 11,
            "maxLength": 11,
            "description": "Trimmed value with exactly 11 characters. The current validator does not enforce that every character is a digit."
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "format": "password",
            "description": "Trimmed password with at least six characters."
          }
        },
        "additionalProperties": true
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Trimmed email address."
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "format": "password",
            "description": "Trimmed password with at least six characters."
          }
        },
        "additionalProperties": true
      },
      "RegisterResponse": {
        "type": "object",
        "required": [
          "status",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "message": {
            "type": "string",
            "example": "User registered successfully"
          }
        },
        "additionalProperties": false
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "status",
          "message",
          "role",
          "token"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "message": {
            "type": "string",
            "example": "Login successful"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ]
          },
          "token": {
            "type": "string",
            "description": "JWT to send in the Authorization header of protected requests."
          }
        },
        "additionalProperties": false
      },
      "UserRecord": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "role",
          "password"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "devv"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "devv@example.com"
          },
          "phone": {
            "type": "string",
            "minLength": 11,
            "maxLength": 11,
            "example": "09047676746"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ]
          },
          "password": {
            "type": "string",
            "format": "password",
            "readOnly": true,
            "description": "Sensitive field currently included in user lookup responses by the implementation. Do not expose it to clients; remove it from responses before production use."
          }
        },
        "additionalProperties": false
      },
      "UserResponse": {
        "type": "object",
        "required": [
          "status",
          "data"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "data": {
            "$ref": "#/components/schemas/UserRecord"
          }
        },
        "additionalProperties": false
      },
      "UserListResponse": {
        "type": "object",
        "required": [
          "status",
          "data"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserRecord"
            }
          }
        },
        "additionalProperties": false
      },
      "RoleWelcomeResponse": {
        "type": "object",
        "required": [
          "status",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "message": {
            "type": "string",
            "example": "Welcome, User"
          }
        },
        "additionalProperties": false
      },
      "FileUploadRequest": {
        "type": "object",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "One file field named file, up to 5 MB."
          }
        },
        "additionalProperties": true
      },
      "FileMetadata": {
        "type": "object",
        "required": [
          "originalname",
          "filename",
          "path",
          "size",
          "mimetype"
        ],
        "properties": {
          "originalname": {
            "type": "string",
            "example": "example.png"
          },
          "filename": {
            "type": "string",
            "example": "example-1700000000000-123456789.png"
          },
          "path": {
            "type": "string",
            "example": "/uploads/example-1700000000000-123456789.png"
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "example": 12345
          },
          "mimetype": {
            "type": "string",
            "enum": [
              "image/jpeg",
              "image/png",
              "image/gif",
              "image/webp",
              "application/pdf",
              "text/plain"
            ]
          }
        },
        "additionalProperties": false
      },
      "FileUploadResponse": {
        "type": "object",
        "required": [
          "message",
          "file"
        ],
        "properties": {
          "message": {
            "type": "string",
            "example": "File uploaded successfully"
          },
          "file": {
            "$ref": "#/components/schemas/FileMetadata"
          }
        },
        "additionalProperties": false
      },
      "ValidationIssue": {
        "type": "object",
        "required": [
          "code",
          "path",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "too_small"
          },
          "path": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "example": [
              "password"
            ]
          },
          "message": {
            "type": "string",
            "example": "Password must be at least 6 characters"
          }
        },
        "additionalProperties": true
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "message": {
            "type": "string",
            "example": "Invalid email or password"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            }
          }
        },
        "additionalProperties": false
      },
      "ValidationErrorResponse": {
        "type": "object",
        "required": [
          "message",
          "errors"
        ],
        "properties": {
          "message": {
            "type": "string",
            "example": "Validation failed"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            }
          }
        },
        "additionalProperties": false
      },
      "StatusErrorResponse": {
        "type": "object",
        "required": [
          "status",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "message": {
            "type": "string",
            "example": "User not found"
          }
        },
        "additionalProperties": false
      }
    },
    "responses": {
      "ValidationBadRequest": {
        "description": "The request body failed Zod validation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationErrorResponse"
            },
            "example": {
              "message": "Validation failed",
              "errors": [
                {
                  "code": "too_small",
                  "path": [
                    "password"
                  ],
                  "message": "Password must be at least 6 characters"
                }
              ]
            }
          }
        }
      },
      "Unauthorized": {
        "description": "The Authorization header is missing or its JWT is invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "missing": {
                "summary": "Missing token",
                "value": {
                  "message": "Authentication required"
                }
              },
              "invalid": {
                "summary": "Invalid token",
                "value": {
                  "message": "Invalid token"
                }
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "The authenticated token does not have the admin role.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "message": "Access denied. Admins only."
            }
          }
        }
      },
      "NotFound": {
        "description": "No matching user or user ID was found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/StatusErrorResponse"
            },
            "example": {
              "status": "error",
              "message": "User not found"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "An unhandled application or configuration error occurred.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/StatusErrorResponse"
            },
            "example": {
              "status": "error",
              "message": "Internal Server Error"
            }
          }
        }
      },
      "RateLimited": {
